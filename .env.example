# GEMINI_API_KEY: Required for server-side Gemini AI brief & script generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LARAVEL_API_URL & REVERB_APP_KEY: Optional external Laravel + Reverb integration endpoints
LARAVEL_API_URL="https://api.yendra-office.example.com"
REVERB_APP_KEY="yendra_reverb_key"
REVERB_HOST="127.0.0.1"
REVERB_PORT="8080"

# MYSQL_URL: Optional MySQL connection string for persistent task storage in production
MYSQL_URL="mysql://user:password@127.0.0.1:3306/yendra_ai_office"

# OPENAI_API_KEY: Optional key for external raster diagram generation (falls back to Gemini SVG + Resvg 1080x1920 PNG)
OPENAI_API_KEY="MY_OPENAI_API_KEY"

